# Documentation only. Do not commit real values or put worker/service keys in EXPO_PUBLIC variables.
# At least 32 random characters, shared by request-account-deletion and process-account-deletions.
PRIVACY_WORKER_SECRET=
# Comma-separated exact HTTPS origins. No wildcard. Needed only for deployed deletion web resource.
PRIVACY_ALLOWED_WEB_ORIGINS=
# Supabase supplies SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY to Edge Functions.
# RevenueCat client accepts only EXPO_PUBLIC_REVENUECAT_TEST_API_KEY beginning test_.
# Retention is configured in private_file_retention_settings; automatic cleanup defaults OFF.
