# Local Edge Function secrets only. Copy to supabase/.env.local (ignored).
# Leave empty for mocked automated tests; tests never need a paid provider key.
GROQ_API_KEY=
# Optional integrations; not needed for interview reliability tests.
REVENUECAT_SECRET_API_KEY=
REVENUECAT_WEBHOOK_SECRET=
# Supabase injects SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY.
# Model/version overrides are documented in docs/ENVIRONMENT.md.
