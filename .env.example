# ---------------------------------------------------------------------------
# VOCARA environment variables
# Copy to .env and fill in real values. NEVER commit .env.
# See docs/ENVIRONMENT.md for the full inventory and where each value lives.
# ---------------------------------------------------------------------------

# --- Mobile client (EXPO_PUBLIC_* are safe to bundle in the app) -----------

# Supabase Dashboard -> Connect -> Mobile frameworks -> Expo React Native
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# RevenueCat Test Store public SDK key
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# Sentry (client DSN is public by design)
EXPO_PUBLIC_SENTRY_DSN=

# --- Server-only secrets (NEVER prefix with EXPO_PUBLIC_) -------------------
# These live in Supabase Edge Function secrets, not in .env.
#
# supabase functions secrets set GROQ_API_KEY=...
# supabase functions secrets set REVENUECAT_SECRET_API_KEY=...
# supabase functions secrets set REVENUECAT_WEBHOOK_SECRET=...
